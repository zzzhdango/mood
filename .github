name: Build OBYS MOOD Installers (Win + macOS)

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build-windows-installer:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - name: Configure & Build VST3 + Standalone
        run: |
          cmake -B build -DCMAKE_BUILD_TYPE=Release
          cmake --build build --config Release --parallel
      - name: Build Windows Setup.exe via Inno Setup
        run: |
          choco install innosetup -y
          & "C:\Program Files (x86)\Inno Setup 6\ISCC.exe" "Installer\OBYS_MOOD.iss"
      - name: Upload Windows Installer Artifact
        uses: actions/upload-artifact@v4
        with:
          name: OBYS_MOOD_Windows_Installer
          path: dist/OBYS_MOOD_Setup_v1.0.0.exe

  build-macos-installer:
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4
      - name: Build Universal VST3/AU/App & Create .pkg
        run: |
          chmod +x Installer/build_macos_pkg.sh
          ./Installer/build_macos_pkg.sh
      - name: Upload macOS .pkg Installer Artifact
        uses: actions/upload-artifact@v4
        with:
          name: OBYS_MOOD_macOS_Installer
          path: dist/OBYS_MOOD_Installer_v1.0.0_macOS.pkg
